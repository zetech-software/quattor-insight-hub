# Public browser configuration, supplied by the target Supabase environment.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Server-only variables belong in Supabase Edge Function secrets, never VITE_*:
# APP_ORIGIN=https://your-application.example
# PAYMENTS_ENVIRONMENT=sandbox  (live only after commercial approval)
# BILLING_ENABLED=false
# LOVABLE_API_KEY=...
# STRIPE_SANDBOX_API_KEY=...
# PAYMENTS_SANDBOX_WEBHOOK_SECRET=...
# STRIPE_LIVE_API_KEY=...
# PAYMENTS_LIVE_WEBHOOK_SECRET=...
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected by Supabase.
